<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/keito_lavanda"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:fontFamily="monospace"
        android:text="@string/tv_app_name"
        android:textColor="@color/keito_morado_oscuro"
        android:textSize="48sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDescripcion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="Tejer con las manos libres: contador de vueltas por voz y tutoriales para principiantes."
        android:textAlignment="center"
        android:textColor="@color/keito_texto"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnIniciarSesion"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:text="Iniciar sesión" />

    <Button
        android:id="@+id/btnRegistrarse"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:text="Registrarse" />

</LinearLayout>