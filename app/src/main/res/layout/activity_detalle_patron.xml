<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/keito_lavanda"
    android:orientation="vertical"
    android:padding="20dp"
    tools:context=".activities.DetallePatronActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivDetalle"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:scaleType="centerCrop"
                app:srcCompat="@drawable/placeholder_patron" />

            <TextView
                android:id="@+id/tvNombreDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="TextView"
                android:textColor="@color/keito_morado_oscuro"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDificultadDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="TextView"
                android:textColor="@color/keito_texto"
                android:textSize="16dp" />

            <TextView
                android:id="@+id/tvVueltasDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="TextView"
                android:textColor="@color/keito_texto"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/Abreviaciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Abreviaciones"
                android:textColor="@color/keito_morado"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAbreviaciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="TextView"
                android:textColor="@color/keito_texto"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/textView9"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Instrucciones"
                android:textColor="@color/keito_morado"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvInstrucciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="TextView"
                android:textColor="@color/keito_texto"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvMultimedia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Multimedia"
                android:textColor="@color/keito_morado"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnAudio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Escuchar audio" />

            <Button
                android:id="@+id/btnVideo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ver video" />

            <VideoView
                android:id="@+id/vvTutorial"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp" />

            <Button
                android:id="@+id/btnEmpezarTejer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Empezar a tejer" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>